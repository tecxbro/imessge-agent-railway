# Required: Photon project with Spectrum Cloud iMessage configured.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
DATABASE_URL=postgresql://agent:replace-me@localhost:5432/imessage_agent
AGENT_OWNER_HANDLES=+15551234567,user@example.com
# Required locally and during migration. New Railway installations can derive a
# stable UUID from RAILWAY_SERVICE_ID, but migrated installations must preserve it.
DEPLOYMENT_ID=00000000-0000-4000-8000-000000000000
# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Use separate absolute paths. These directories are ignored by Git.
CODEX_HOME=/absolute/path/to/.codex-agent
AGENT_WORKSPACE_ROOT=/absolute/path/to/.agent-workspaces
CODEX_AUTH_MODE=chatgpt
# Required only when CODEX_AUTH_MODE=api_key.
# OPENAI_API_KEY=

# Leave SUPERMEMORY_API_KEY empty to disable semantic memory.
SUPERMEMORY_API_KEY=
SUPERMEMORY_CONTAINER_PREFIX=imessage-agent

MODEL_FAST=gpt-5.6-luna
MODEL_FAST_EFFORT=medium
MODEL_MAIN=gpt-5.6-luna
MODEL_MAIN_EFFORT=high
MODEL_BALANCED=gpt-5.6-terra
MODEL_BALANCED_EFFORT=high
MODEL_HARD=gpt-5.6-luna
MODEL_HARD_EFFORT=max
MODEL_DEEP=gpt-5.6-sol
MODEL_DEEP_EFFORT=max
ALLOW_REASONING_FALLBACK=false

INBOUND_DEBOUNCE_MS=4000
MAX_EXECUTION_CONCURRENCY=3
MAX_OWNER_EXECUTION_CONCURRENCY=2
MESSAGE_RATE_LIMIT_PER_MINUTE=60
TASK_RATE_LIMIT_PER_HOUR=120
MAX_TASK_RUNTIME_MS=900000
RAW_MESSAGE_RETENTION_DAYS=30
FAILURE_RETENTION_DAYS=14
PAIRING_MODE=off
GROUP_MODE=owner_mentions_only
LOG_MESSAGE_CONTENT=false
PORT=10000
